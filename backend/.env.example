# Google Gemini API
# Hackathon süresince https://aistudio.google.com/apikey adresinden ücretsiz anahtar al
GEMINI_API_KEY=

# Model seçimleri
# NOT: 2.5-pro ve 2.0-flash free tier'da quota=0 olabiliyor.
# Free tier'da çalışan modeller: gemini-2.5-flash-lite, gemini-flash-lite-latest,
# gemini-flash-latest, gemini-3.1-flash-lite. Aşağıdaki varsayılanlar test edildi.
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_VISION=gemini-2.5-flash-lite

# Mock mode: API key olmadan veya geliştirme sırasında deterministic mock'lar kullan
# true → API çağrısı yok, canned cevaplar (test/CI için)
# false → gerçek Gemini'ye git
MOCK_MODE=true

# Cache ayarları
SCRAPER_CACHE_TTL=3600
GOLDEN_QUERIES=kulaklik,klavye,olta,anne_hediye,sirt_cantasi

# Pazarlık sınırları
NEGOTIATION_MAX_TURNS=6
NEGOTIATION_TARGET_DISCOUNT_PCT=15
